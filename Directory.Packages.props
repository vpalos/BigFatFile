<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Contracts">
        <PackageVersion Include="Blake3" Version="3.0.2" />
    </ItemGroup>

    <ItemGroup Label="Data">
        <PackageVersion Include="Dapper" Version="2.1.89" />
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup Label="Identity and OpenID Connect">
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
        <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />
        <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    </ItemGroup>

    <ItemGroup Label="Jobs">
        <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
        <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
        <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    </ItemGroup>

    <ItemGroup Label="API">
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14" />
        <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
    </ItemGroup>

    <ItemGroup Label="Observability">
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
        <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Hangfire" Version="1.20.1-beta.1" />
        <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    </ItemGroup>
</Project>

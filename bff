#!/usr/bin/env bash
# Commands for working on this repository. Needs Docker with the Compose plugin.
#
#   ./bff dev up      start the Origin, PostgreSQL and the Aspire dashboard;
#                     the Origin applies saved changes to its code with Hot Reload
#   ./bff dev down    stop them and keep the data
#   ./bff dev reset   stop them and delete the data and the build cache
#   ./bff dev logs    follow the Origin's log

set -euo pipefail
cd "$(dirname "$0")"

# The development database password; the reference deployment takes it from .env instead.
export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-bigfatfile-dev}"

compose() {
    docker compose --file docker-compose.yml --file docker-compose.dev.yml "$@"
}

usage() {
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
}

[[ "${1:-}" == "dev" ]] || usage

case "${2:-}" in
    up)
        compose up --detach --wait
        cat <<INFO

The Origin is running.
  Sign in        http://localhost:${BFF_PORT:-8080}/account/sign-in
  API reference  http://localhost:${BFF_PORT:-8080}/api/docs
  Job dashboard  http://localhost:${BFF_PORT:-8080}/admin/jobs
  Telemetry      http://localhost:${BFF_ASPIRE_PORT:-18888}
  PostgreSQL     localhost:${BFF_DB_PORT:-5432}, user bigfatfile, password ${POSTGRES_PASSWORD}

Demo user: demo@bigfatfile.local / bigfatfile-demo

The Origin applies saved changes with Hot Reload; ./bff dev logs shows it.
INFO
        ;;
    down) compose down ;;
    reset) compose down --volumes ;;
    logs) compose logs --follow origin ;;
    *) usage ;;
esac

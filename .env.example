# Copy to .env next to docker-compose.yml.

# The password of the bigfatfile database user, which owns the tables.
# Choose a long random value.
POSTGRES_PASSWORD=

# The password of the bigfatfile_app database user, which the Origin uses for requests.
# The Origin creates this user on first start. Choose another long random value.
BFF_DATABASE_PASSWORD=

# The image tag to run. Pin the major version in production, for example 1.
BFF_IMAGE_TAG=edge

# The host port the Origin listens on.
BFF_PORT=8080

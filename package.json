    "docs:dev": "vitepress dev docs --port 3000",
    "docs:build": "vitepress build docs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mermaid": "^12.3.0",
    "typescript": "~5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.2.3",
    "vitest": "^5.0.5"
  }
}

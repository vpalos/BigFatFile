{
  "name": "bigfatfile",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "pnpm --recursive run generate",
    "build": "pnpm --recursive run build",
